{
  "name": "aipaysec",
  "version": "1.0.0",
  "description": "Adversarial GenAI Framework for Proactive Testing of Payment-Fraud Defenses",
  "main": "simulator/src/server.js",
  "scripts": {
    "dev": "nodemon simulator/src/server.js",
    "start": "node simulator/src/server.js",
    "migrate": "node simulator/src/infrastructure/postgres/migrator.js",
    "mongo:init": "node simulator/src/infrastructure/mongodb/init.js",
    "test": "node --test simulator/tests/**/*.test.js red-team/tests/**/*.test.js",
    "test:simulator": "node --test simulator/tests/**/*.test.js",
    "test:redteam": "node --test red-team/tests/**/*.test.js",
    "test:m2": "node --test redteam/tests/**/*.test.js",
    "test:m2:unit": "node --test redteam/tests/unit/*.test.js",
    "test:m2:integration": "node --test redteam/tests/integration/*.test.js",
    "test:m3": "node --test attack-primitives/tests/**/*.test.js",
    "test:m3:unit": "node --test attack-primitives/tests/unit/*.test.js",
    "test:m3:integration": "node --test attack-primitives/tests/integration/*.test.js",
    "test:m5": "node --test blueteam/tests/**/*.test.js",
    "test:m5:unit": "node --test blueteam/tests/unit/*.test.js",
    "test:m5:integration": "node --test blueteam/tests/integration/*.test.js",
    "blueteam:start": "node blueteam/src/server.js",
    "test:all": "node --test simulator/tests/**/*.test.js redteam/tests/**/*.test.js attack-primitives/tests/**/*.test.js blueteam/tests/**/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}